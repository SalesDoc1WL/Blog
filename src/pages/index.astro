---
import BaseLayout from "../layouts/BaseLayout.astro";

// --- Données CV --------------------------------------------------------------
const experiences = [
  {
    role: "Cadre — Ingénieur d'affaires BPO",
    co: "DocOne",
    when: "2025 · 14 mois",
    meta: "CDI · Externalisation documentaire",
    points: [
      "Réponses aux appels d'offres des pouvoirs publics",
      "POC clients sur solutions GED / SAE",
      "Chiffrage des services BPO : GED, SAE, production documentaire et communication",
    ],
    kpis: [],
  },
  {
    role: "Ingénieur commercial GED",
    co: "Office Plus — Nouvelle-Calédonie",
    when: "2024 · 12 mois",
    meta: "CDI · Intégration IT & Télécom",
    points: [
      "Chiffrage d'intégration informatique et télécom (software & hardware)",
      "Études de financement leaser (Mutualease, Grenke, BNP Finance…)",
      "Démonstrateur produit (POC) : Eukles / Therefore",
      "Gestion des demandes d'interventions techniques",
    ],
    kpis: ["24 K€ de marge", "+37 nouveaux clients", "100 % de croissance", "Cross-selling 10 K€"],
  },
  {
    role: "Ingénieur commercial GED & Reprographie",
    co: "Koesio",
    when: "2020 – 2023 · 3 ans",
    meta: "CDI · Avant-vente & portefeuille",
    points: [
      "Avant-vente hardware / software : borne interactive, totem, affichage dynamique",
      "Gestion d'un portefeuille de 200 clients en reprographie",
      "Animation commerciale : salons, formation de l'équipe commerciale",
    ],
    kpis: ["75 % de renouvellement", "30 % de vente additionnelle", "200 clients gérés"],
  },
  {
    role: "Business Developer — Solution numérique",
    co: "Comongo",
    when: "2019 · 1 an",
    meta: "CDI · Gouvernance en holacratie",
    points: [
      "Cycle commercial complet : 1er RDV, démonstration, négociation, signature",
      "Analyse et segmentation des prospects (personae, veille concurrentielle)",
      "Acquisition via Sales Navigator & LinkedIn, animation dans le CRM Sellsy",
      "Amélioration des processus et stratégies commerciales, reporting",
    ],
    kpis: [],
  },
  {
    role: "Assistant chef de projet marketing & relation commerciale",
    co: "SNCF — Direction régionale TER Mobilités",
    when: "2017 – 2018 · 2 ans",
    meta: "Alternance",
    points: [
      "Création de Journey Builder CRM : mailing, SMS, notifications push",
      "Conception des messages internes (agents vente, accueil, contrôle) et externes (clients, offices de tourisme)",
    ],
    kpis: ["66 % de taux d'ouverture", "4 % de taux de clic", "7-12 contenus / mois"],
  },
];

const gedSkills = [
  { name: "Therefore", lvl: "Expert", pct: 100, expert: true },
  { name: "Eukles", lvl: "Expert", pct: 100, expert: true },
];
const toolSkills = [
  { name: "Artis", lvl: "Avancé", pct: 82 },
  { name: "Progiciel Cristal", lvl: "Avancé", pct: 82 },
  { name: "PipeDrive", lvl: "Avancé", pct: 82 },
  { name: "Word · Excel · PowerPoint", lvl: "Avancé", pct: 85 },
  { name: "Illustrator · InDesign", lvl: "Intermédiaire", pct: 58 },
  { name: "Salesforce Marketing Cloud", lvl: "Débutant", pct: 35 },
  { name: "SAGE 100", lvl: "Débutant", pct: 32 },
  { name: "HTML · CSS", lvl: "Débutant", pct: 30 },
];

const softSkills = ["Humble", "Sociable", "Empathique", "Autonome", "Patient", "Capacité d'adaptation"];

const formations = [
  { yr: "2018 – 2020", title: "Master Stratégie & Innovation Marketing Digitale", school: "IDRAC — Bordeaux", n: "01" },
  { yr: "2017 – 2018", title: "Licence professionnelle Rédaction Web", school: "Université Grenoble Alpes", n: "02" },
  { yr: "2013 – 2015", title: "BTS Communication & Publicité", school: "ISCOM — Lyon", n: "03" },
];

// Captures produit Viviar (données de démonstration, compte « Camille Demo »)
const viviarShots = [
  { src: "/img/viviar/dashboard.png", alt: "Tableau de bord Viviar", cap: "Le tableau de bord : les contacts à rappeler aujourd'hui, triés par Signal, avec le motif de l'appel." },
  { src: "/img/viviar/contacts.png", alt: "Liste des contacts Viviar", cap: "Le vivier complet, segmenté chaud / tiède / froid selon le dernier signe de vie." },
  { src: "/img/viviar/fiche-contact.png", alt: "Fiche contact Viviar", cap: "La fiche contact : pourquoi appeler maintenant, angle d'appel suggéré, trajectoire du signal." },
  { src: "/img/viviar/confiance-rgpd.png", alt: "Confiance & conformité Viviar", cap: "Hébergement en France, cadre RGPD de bout en bout, aucun traceur tiers." },
];
const viviarStack = ["PocketBase", "Go", "Next.js", "Scaleway", "IA générative"];
---

<BaseLayout>
  <!-- ============================ NAV ============================ -->
  <nav class="nav" id="nav">
    <a href="#top" class="nav__brand"><span class="dot"></span>Willie Leroux</a>
    <div class="nav__links" id="navlinks">
      <a href="#viviar">Viviar</a>
      <a href="#parcours">Parcours</a>
      <a href="#competences">Compétences</a>
      <a href="#formations">Formations</a>
      <a href="#contact" class="nav__cta">Me contacter</a>
    </div>
    <button class="nav__burger" id="burger" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
  </nav>

  <!-- ============================ HERO ============================ -->
  <header class="hero" id="top">
    <div class="hero__mesh"></div>
    <div class="hero__grid-overlay"></div>
    <div class="wrap hero__inner">
      <div>
        <span class="hero__status reveal"><span class="pulse"></span>En reconversion · vers la technique & les nouvelles technologies</span>
        <h1 class="reveal" data-d="1">Willie<br /><span class="accent">Leroux.</span></h1>
        <p class="hero__role reveal" data-d="2">Cap sur la technique · <b>conception & production documentaire</b></p>
        <p class="hero__desc reveal" data-d="2">
          Actuellement ingénieur d'affaires GED chez Docone, je prospecte et réponds aux appels
          d'offres en GED, SAE et éditique. Aujourd'hui je veux m'éloigner du commerce pour un
          quotidien plus technique et sédentaire : devenir expert en conception et production
          documentaire, au contact des nouvelles technologies. Mon appétence pour la tech, je la
          nourris en construisant <b>Viviar</b>, un SaaS que j'ai codé et mis en ligne seul.
        </p>
        <div class="hero__actions reveal" data-d="3">
          <a href="#viviar" class="btn btn--flame">Voir ce que j'ai construit <span class="arrow">↗</span></a>
          <a href="#contact" class="btn btn--ghost">Me contacter</a>
        </div>
        <div class="hero__chips reveal" data-d="4">
          <span class="chip"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h6"/></svg>GED · SAE · éditique</span>
          <span class="chip"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 19l7-7-3-3-7 7v3zM16 5l3 3"/></svg>PAO · Illustrator · InDesign</span>
          <span class="chip"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 17l6-6-6-6M12 19h8"/></svg>Créateur du SaaS Viviar</span>
          <span class="chip"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 21h18M6 21V9l6-4 6 4v12"/></svg>Grésy-sur-Aix (73) · Permis B</span>
        </div>
      </div>

      <div class="hero__portrait reveal" data-d="2">
        <div class="hero__portrait-frame">
          <img src="/img/willie-portrait.jpg" alt="Portrait de Willie Leroux" width="360" height="360" fetchpriority="high" />
        </div>
        <div class="hero__badge hero__badge--tl">
          <div class="n">LIVE</div><div class="l">viviar.fr en production</div>
        </div>
        <div class="hero__badge hero__badge--br">
          <div class="n">GED</div><div class="l">SAE · éditique · PAO</div>
        </div>
      </div>
    </div>
    <div class="wrap"><span class="hero__scroll"><span class="line"></span>Faites défiler</span></div>
  </header>

  <!-- ============================ KPI BAND ============================ -->
  <section class="section section--dark" style="padding-block: clamp(48px,6vw,80px)">
    <div class="wrap">
      <span class="eyebrow reveal">En quelques chiffres</span>
      <h2 class="h2 reveal" data-d="1" style="margin-bottom:14px">Ce que ça donne, concrètement.</h2>
      <p class="lead reveal" data-d="2" style="margin-bottom:38px">Des chiffres réunis au fil de mes cinq postes, du privé au service public. Derrière chacun, il y a surtout des gens accompagnés et une parole tenue.</p>
      <div class="kpis reveal" data-d="1">
        <div class="kpi"><div class="kpi__n"><span data-count="4">0</span><span class="u">+</span></div><div class="kpi__l">années d'expérience, dans des univers très différents<span class="kpi__src">DocOne · Office Plus · Koesio · Comongo · SNCF</span></div></div>
        <div class="kpi"><div class="kpi__n"><span class="u">+</span><span data-count="37">0</span></div><div class="kpi__l">clients accompagnés en un an<span class="kpi__src">Office Plus</span></div></div>
        <div class="kpi"><div class="kpi__n"><span data-count="200">0</span></div><div class="kpi__l">clients suivis au quotidien<span class="kpi__src">Koesio</span></div></div>
        <div class="kpi"><div class="kpi__n"><span data-count="75">0</span><span class="u"> %</span></div><div class="kpi__l">de clients qui ont renouvelé leur confiance<span class="kpi__src">Koesio</span></div></div>
      </div>
      <div class="kpi-more reveal" data-d="2">
        <span class="lbl">et aussi</span>
        <span class="kpi-pill"><b>100 %</b> de croissance en un an · Office Plus</span>
        <span class="kpi-pill"><b>30 %</b> de ventes additionnelles · Koesio</span>
        <span class="kpi-pill"><b>66 %</b> d'ouverture sur mes emailings · SNCF</span>
        <span class="kpi-pill"><b>7 à 12</b> contenus créés par mois · SNCF</span>
      </div>
    </div>
  </section>

  <!-- ============================ PROFIL ============================ -->
  <section class="section" id="profil">
    <div class="wrap" style="max-width: 900px">
      <span class="eyebrow reveal">Le cap</span>
      <p class="h2 reveal" data-d="1" style="max-width: 24ch; margin-bottom: 28px">M'éloigner du commerce, aller vers la technique.</p>
      <p class="lead reveal" data-d="2" style="max-width: 68ch; font-size: clamp(18px,2.2vw,22px); color: var(--text)">
        Actuellement ingénieur d'affaires chez Docone à Mérignac, je prospecte et réponds aux
        appels d'offres en GED, SAE et éditique. Avec l'agrandissement de ma famille, je souhaite
        aujourd'hui m'éloigner du commerce au profit d'un quotidien plus sédentaire et technique.
      </p>
      <p class="lead reveal" data-d="3" style="max-width: 68ch; font-size: clamp(18px,2.2vw,22px); color: var(--text); margin-top:20px">
        Déjà familiarisé avec les standards de la gestion documentaire, je veux désormais devenir un
        véritable expert technique en conception et production documentaire. Pour réussir ce virage,
        je recherche une entreprise prête à me proposer un vrai parcours d'intégration et de
        formation progressive.
      </p>
      <p class="lead reveal" data-d="3" style="max-width: 68ch; font-size: clamp(18px,2.2vw,22px); color: var(--text); margin-top:20px">
        Mes expériences et mes études m'ont donné des bases solides en PAO. Je ne me prétends pas
        expert, mais ce sont des acquis immédiatement mobilisables — et le goût des nouvelles
        technologies que j'ai nourri en construisant Viviar.
      </p>
    </div>
  </section>

  <!-- ============================ VIVIAR ============================ -->
  <section class="section section--dark" id="viviar">
    <div class="wrap">
      <span class="eyebrow reveal">Nouvelles technologies · ce que je construis en autonomie</span>
      <h2 class="h2 reveal" data-d="1">Viviar : mon terrain d'apprentissage technique.</h2>
      <p class="lead reveal" data-d="2" style="margin-top:18px; font-size: clamp(18px,2.2vw,22px)">
        Pour me former aux nouvelles technologies, j'ai conçu et mis en production Viviar, un SaaS
        complet, seul. C'est la mémoire du fichier d'une agence immobilière : il repère les contacts
        qui dorment dans la boîte mail, détecte ceux qui redonnent des signes d'intérêt et pousse
        chaque matin une courte liste priorisée par <b>Signal</b> — chaud, tiède, froid. Du code à la
        mise en ligne, la conformité RGPD, l'IA générative comme outil : tout est passé par mes mains.
      </p>
      <div class="kpi-more reveal" data-d="3" style="margin-top:24px">
        <span class="kpi-pill"><b>Mémoire du vivier</b> · se souvient du silence, garde l'historique</span>
        <span class="kpi-pill"><b>Liste du matin</b> · les bons appels, priorisés, sans la demander</span>
        <span class="kpi-pill"><b>France / RGPD</b> · hébergé à Paris, zéro traceur tiers</span>
      </div>

      <div class="vv-gallery reveal" data-d="2">
        {viviarShots.map((s) => (
          <figure class="vv-shot">
            <div class="vv-shot__frame">
              <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption>{s.cap}</figcaption>
          </figure>
        ))}
      </div>

      <div class="vv-foot reveal" data-d="3">
        <div class="vv-stack">
          <span class="vv-stack__lbl">Stack</span>
          {viviarStack.map((t) => <span class="vv-stack__tag">{t}</span>)}
        </div>
        <a href="https://viviar.fr/" target="_blank" rel="noopener" class="btn btn--flame">Voir viviar.fr <span class="arrow">↗</span></a>
      </div>
      <p class="vv-note reveal" data-d="4">Captures issues du produit réel, sur des données de démonstration (compte « Camille Demo »).</p>
    </div>
  </section>

  <!-- ============================ PARCOURS ============================ -->
  <section class="section section--alt" id="parcours">
    <div class="wrap">
      <span class="eyebrow reveal">Expériences professionnelles</span>
      <h2 class="h2 reveal" data-d="1">Un parcours qui se lit en résultats.</h2>
      <div class="timeline">
        {experiences.map((x, i) => (
          <div class="tl-item reveal" data-d={(i % 3) + 1}>
            <span class="tl-dot"></span>
            <div class="tl-card">
              <div class="tl-head">
                <div class="tl-role">{x.role} · <span class="tl-co">{x.co}</span></div>
                <span class="tl-when">{x.when}</span>
              </div>
              <div class="tl-meta">{x.meta}</div>
              <ul class="tl-list">
                {x.points.map((p) => <li>{p}</li>)}
              </ul>
              {x.kpis.length > 0 && (
                <div class="tl-kpis">
                  {x.kpis.map((k) => <span class="tl-kpi">{k}</span>)}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ COMPÉTENCES ============================ -->
  <section class="section" id="competences">
    <div class="wrap">
      <span class="eyebrow reveal">Compétences</span>
      <h2 class="h2 reveal" data-d="1">Des bases techniques déjà là.</h2>
      <p class="lead reveal" data-d="2" style="margin-top:14px">Gestion documentaire, PAO et nouvelles technologies : des acquis mobilisables tout de suite, à faire monter en expertise.</p>
      <div class="skill-grid">
        <div class="skill-card reveal" data-d="1">
          <h3><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h6"/></svg></span>GED SaaS</h3>
          <div class="sub">Gestion électronique de documents</div>
          {gedSkills.map((s) => (
            <div class="bar-row">
              <div class="bar-top"><span class="bar-name">{s.name}</span><span class="bar-lvl">{s.lvl}</span></div>
              <div class="bar-track"><span class={"bar-fill" + (s.expert ? " expert" : "")} data-w={s.pct}></span></div>
            </div>
          ))}
          <div class="sub" style="margin-top:22px;margin-bottom:12px">CRM & prospection</div>
          <div class="tag-cloud">
            <span class="tag">Salesforce MC</span><span class="tag">PipeDrive</span>
            <span class="tag">Sellsy</span><span class="tag">Sales Navigator</span><span class="tag">LinkedIn</span>
          </div>
        </div>

        <div class="skill-card reveal" data-d="2">
          <h3><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3M3 16v3a2 2 0 002 2h3m8 0h3a2 2 0 002-2v-3M9 9l2 2-2 2m4 2h2"/></svg></span>Technique & nouvelles technologies</h3>
          <div class="sub">Appris en construisant Viviar</div>
          <div class="tag-cloud">
            <span class="tag">Next.js</span><span class="tag">Go</span><span class="tag">PocketBase</span>
            <span class="tag">Scaleway</span><span class="tag">IA générative</span><span class="tag">HTML · CSS</span>
            <span class="tag">RGPD by design</span>
          </div>
          <div class="sub" style="margin-top:22px;margin-bottom:0">Du code à la mise en production, en autonomie.</div>
        </div>

        <div class="skill-card reveal" data-d="1">
          <h3><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v12H4z"/><path d="M2 20h20M9 8l2 2 4-4"/></svg></span>Outils & bureautique</h3>
          <div class="sub">Logiciels maîtrisés</div>
          {toolSkills.map((s) => (
            <div class="bar-row">
              <div class="bar-top"><span class="bar-name">{s.name}</span><span class="bar-lvl">{s.lvl}</span></div>
              <div class="bar-track"><span class="bar-fill" data-w={s.pct}></span></div>
            </div>
          ))}
        </div>

        <div class="skill-card reveal" data-d="1">
          <h3><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/><circle cx="12" cy="12" r="10"/></svg></span>Langues</h3>
          <div class="sub">Écrit & oral</div>
          <div class="bar-row"><div class="bar-top"><span class="bar-name">Français</span><span class="bar-lvl">Langue maternelle</span></div><div class="bar-track"><span class="bar-fill expert" data-w="100"></span></div></div>
          <div class="bar-row"><div class="bar-top"><span class="bar-name">Anglais</span><span class="bar-lvl">Niveau C1</span></div><div class="bar-track"><span class="bar-fill" data-w="85"></span></div></div>
        </div>

        <div class="skill-card reveal" data-d="2">
          <h3><span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a5 5 0 015 5c0 2-1 3-1 5H8c0-2-1-3-1-5a5 5 0 015-5zM9 20h6M10 22h4"/></svg></span>Soft skills</h3>
          <div class="sub">Ce que disent mes équipes</div>
          <div class="tag-cloud">
            {softSkills.map((s) => <span class="tag soft">{s}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ FORMATIONS ============================ -->
  <section class="section section--alt" id="formations">
    <div class="wrap">
      <span class="eyebrow reveal">Formations</span>
      <h2 class="h2 reveal" data-d="1">Les fondations.</h2>
      <div class="edu-grid">
        {formations.map((f, i) => (
          <div class="edu-card reveal" data-d={i + 1}>
            <span class="num">{f.n}</span>
            <div class="yr">{f.yr}</div>
            <h3>{f.title}</h3>
            <div class="school">{f.school}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CENTRES D'INTÉRÊT ============================ -->
  <section class="section section--dark" id="interets">
    <div class="wrap">
      <span class="eyebrow reveal">Loisirs & engagements</span>
      <h2 class="h2 reveal" data-d="1">Ce qui me tient en mouvement.</h2>
      <div class="interest-grid">
        <div class="int-card reveal" data-d="1">
          <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2l3 5-3 3-3-3zM4.5 8l5 2v4l-5 1zM19.5 8l-5 2v4l5 1zM8 19l4-2 4 2"/></svg></div>
          <h3>Football</h3>
          <p>Dix ans de compétition. J'y ai pris le goût de l'effort et le sens du collectif.</p>
        </div>
        <div class="int-card reveal" data-d="2">
          <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 4l-2 6h5l-4 10 1-7H8z"/></svg></div>
          <h3>Trail</h3>
          <p>La course en montagne, pour la tête autant que pour les jambes. Le terrain, encore.</p>
        </div>
        <div class="int-card reveal" data-d="3">
          <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-7-10a4 4 0 017-2 4 4 0 017 2c0 5.5-7 10-7 10z"/></svg></div>
          <h3>Auxiliaire de vie</h3>
          <p>Un passage à l'agence ADPA, auprès de personnes dépendantes. Du concret et de l'humain, tous les jours.</p>
        </div>
        <div class="int-card reveal" data-d="1">
          <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/><circle cx="12" cy="12" r="9"/></svg></div>
          <h3>Londres</h3>
          <p>Dix mois sur place en voyage linguistique. De quoi installer un anglais courant, niveau C1.</p>
        </div>
        <div class="int-card reveal" data-d="2">
          <div class="ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M12 2a15 15 0 010 20"/><circle cx="12" cy="12" r="10"/></svg></div>
          <h3>Voyages</h3>
